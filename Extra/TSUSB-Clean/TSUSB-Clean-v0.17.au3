Exit



Func USBstickDetection($hWndGUI, $MsgID, $WParam, $LParam)
	ConsoleWrite("USBbeingprocessed="& $USBStickBeingProcessed & @crlf)

	if $USBStickBeingProcessed = true Then
		Return
	Else
		$USBStickBeingProcessed = true
	EndIf
	; if shift (left or right) is pressed while inserting the USB stick then a menu will pop up with the option to stop the script
	; Also the language can be changed as on every panel
	If IsShiftPressed() Then
		; Display the two buttons. The second (2) is the exit button
		; ---> DisplayPanel(1, $hGUI1, $hdrStopScript, "", $btnContinue, $mbtnEndScript, "", 2)
		Msgbox(64,"stopping","Stopping because of SHIFT pressed")
		exit
	EndIf

	; msgbox(4096,"bla",$MsgID,2)
		sleep (1000)
	Local $aArray = DriveGetDrive($DT_REMOVABLE)
	Local $i
	If @error Then
		; An error occurred when retrieving the drives.
		ConsoleWrite ("It appears an error occurred after DriveGetDrive." & @CRLF)
	Else

		;Go through all driveletters with removable drives and see whether it is the one for TurtleStitch
		ConsoleWrite("Number of drives = " & $aArray[0] & @CRLF)
		$USBvolume=""
		For $i = 1 To $aArray[0]
			sleep (1000)
			; Get the driveletters of the removable drives
			Local $DriveLetter = $aArray[$i]
			ConsoleWrite("$DriveLetter=" & $DriveLetter & @CRLF)
			; Get the volumelabel given the driveletter
			$USBvolume = DriveGetLabel($DriveLetter)
			if $USBvolume="" Then
				ConsoleWrite("after blank USB volume, @error=" & @error & @crlf)

				$bArray = DriveGetDrive($DT_REMOVABLE)
				ConsoleWrite("After blank USB volume, number of drives =" & $bArray[0] & @CRLF)

			else

				if @error = 2 Then  ; 2 is wrong, should be 1, to be looked at later
					ConsoleWrite("416 $USBvolume=" & $USBvolume & @CRLF)
					_WinAPI_EjectMedia($DriveLetter)

					GUICtrlSetData($txtResult,"Volume label could not be obtained. Remove the USB stick. It is already ejected")
					GUICtrlSetBkColor($txtResult,$BackgroundColorError)
					GUICtrlSetColor($txtResult,$ForegroundColorError)
				else
					ConsoleWrite("396 $USBvolume=" & $USBvolume & @CRLF)
					Local $result = 2
					;MsgBox(0,"label", $DriveLetter)

					If StringInStr($USBvolume, $USBstickPrefixTurtleSt, 1) = 1 Then
						consolewrite ("aDriveletter="&$DriveLetter& "\*" & "b" & @CRLF)
						$Path4Sizearray=$DriveLetter&"\*"
						$result=IsStickEmpty($Path4Sizearray)

						if $result=true then

							_WinAPI_EjectMedia($DriveLetter)

							GUICtrlSetData($txtResult,"The stick is already empty. Volumelabel = " & $USBvolume & ". Remove the USB stick. It is already ejected")
							GUICtrlSetBkColor($txtResult,$BackGroundColorEmpty)
							GUICtrlSetColor($txtResult,$ForegroundColorEmpty)
						else

							ConsoleWrite("voor MoveTSfiles" & @crlf)
							$result = MoveTSfilesFromStick( $DriveLetter, $USBvolume)

							consolewrite("after moveTS. Result="& $result & @CRLF)

							if $result=2 Then
								$Path4Sizearray=$DriveLetter&"\*"
								$result=IsStickEmpty($Path4Sizearray)

								if $result=false then
								;if $sizearray[1] + $sizearray[2] <> 0 Then
									FileClose ($result)
									GUICtrlSetData($txtResult,"TurtleStitch content (if any) of USB stick " & $USBvolume & " has been copied, but the stick is not empty. Click Next or click Open USB Stick, inspect and then click Next to eject.")
									GUICtrlSetBkColor($txtResult,$BackgroundColorWarning)
									GUICtrlSetColor($txtResult,$ForegroundColorWarning)
									;$result=FileFindFirstFile($Path4Sizearray)
									;if $result=-1 then
									GUICtrlSetData($mtxtDescription,"")
									GUICtrlSetData($txtName,"")

									$DriveForShellExecute=$DriveLetter
									GUICtrlSetState($btnNext,$GUI_ENABLE)
									GUICtrlSetState($btnOpenExplorer,$GUI_ENABLE)

								else
									_WinAPI_EjectMedia($DriveLetter)

									GUICtrlSetData($txtResult,"Content of USB stick " & $USBvolume & " has been copied. Remove the USB stick. It is already ejected")
									GUICtrlSetBkColor($txtResult,$BackgroundColorNormal)
									GUICtrlSetColor($txtResult,$ForegroundColorNormal)
									GUICtrlSetData($mtxtDescription,"")
									GUICtrlSetData($txtName,"")

								EndIf
							else
								;_WinAPI_EjectMedia($DriveLetter)
								GUICtrlSetData($txtResult,"Something went wrong. Volumelabel = " & $USBvolume & ". Remove the USB stick. It is already ejected")
								GUICtrlSetBkColor($txtResult,$BackgroundColorError)
								GUICtrlSetColor($txtResult,$ForegroundColorError)
							endif


						EndIf
					Else
						if $USBvolume <> "" then
							_WinAPI_EjectMedia($DriveLetter)
							GUICtrlSetData($txtResult,"This is not a TurtleStitch stick. Volumelabel = " & $USBvolume & ". Remove the USB stick. It is already ejected")
							GUICtrlSetBkColor($txtResult,$BackgroundColorWarning)
							GUICtrlSetColor($txtResult,$ForegroundColorWarning)
						endif

					EndIf
				EndIf
			EndIf
			;msgbox(0,"USB drive",$USBvolume,2)
		Next



		; DBT_DEVICEREMOVECOMPLETE
	EndIf
	ConsoleWrite("Setting to False"&@CRLF)
	$USBStickBeingProcessed = False
EndFunc   ;==>USBstickDetection


func IsStickEmpty($Path)

	local $h_search=FileFindFirstFile($Path)
	if $h_search= -1 Then
		return True
	Else
		while 1
			local $filename = FileFindNextFile($h_search)
			if @error then ExitLoop
			consolewrite ($filename & @crlf)
			if $filename <> "System Volume Information" then
				fileclose($h_search)
				return false
			endif
		WEnd
		fileclose($h_search)
		return True
	EndIf
EndFunc


Func NowAsString()
		local $Now= _NowCalc()
		;ConsoleWrite("Now=" & $Now & @CRLF)
		$Now=stringreplace($Now,"/","-")
		$Now=StringReplace($Now," ","--")
		$Now=StringReplace($Now, ":", "-")
		;ConsoleWrite("Now=" & $Now & @CRLF)
		Return $Now
EndFunc

Func NowDate()
	Return StringLeft(NowAsString(), 10)
EndFunc



Func MoveTSfilesFromStick($USBDriveLetter, $USBvolume)



	Local $Dir2Test = $USBDriveLetter & "\"
	ConsoleWrite("aa" & $USBDriveLetter & "bb")
	If FileExists($Dir2Test) = 0 Then

		;$result = DisplayPanel(1, $hGUI1, $hdrFailure, $msgNoUSBStick, $mbtnOK, "", "")
		;MsgBox($MB_ICONERROR, "Geen USB Stick", $msgNoUSBStick)
		ConsoleWrite("There is no USB stick" & @CRLF)

		Return 1
	EndIf

	;ClearUSBStick($USBDriveLetter)



	If FileExists($USBDriveLetter & "\*.DST") or FileExists($USBDriveLetter & "\" & $ExtraDataFileName) or FileExists($USBDriveLetter & "\" & $TSOldPrefix & "*") Then
		Local $Now=NowAsString()
		;_DebugSetup

		local $NameExt = GUICtrlRead($txtName)
		if $NameExt="" then
			$TargetDir = $ResultsNormalFolder & "\" & $USBvolume & "-" & $Now
		Else
			$DescriptionText=GUICtrlRead($mtxtDescription)
			$TargetDir = $ResultsSpecialFolder & "\" & $USBvolume & "-" & $Now & "-" & $NameExt
			$h_file=Fileopen($TargetDir & "\DataWhenEmptied.txt",bitor ( $FO_OVERWRITE ,$FO_CREATEPATH ))
			ConsoleWrite("h_file=" & $h_file & @CRLF)
			ConsoleWrite("x" & $DescriptionText & "x" & @CRLF)
			$result=Filewrite($h_file,$DescriptionText)
			ConsoleWrite("$result=" & $result & @crlf)
			FileClose($h_file)

		EndIf
		$result=DirCreate($TargetDir)

		$result=MoveMultipleFilesOrDirs($USBDriveLetter&"\","*.DST", $TargetDir)
		ConsoleWrite("Filemove DST result=" & $result & @CRLF)
		$result=MoveMultipleFilesOrDirs($USBDriveLetter&"\","*.XML", $TargetDir)
		ConsoleWrite("Filemove XML result=" & $result & @CRLF)
		$result=MoveMultipleFilesOrDirs($USBDriveLetter & "\", $ExtraDataFileName, $TargetDir)
		ConsoleWrite("Filemove Extrafile result=" & $result & @CRLF)
		$result=MoveMultipleFilesOrDirs($USBDriveLetter & "\" , $TSOldPrefix & "*", $TargetDir)
		ConsoleWrite("Dirmove TSOLD result=" & $result & @CRLF)

	EndIf
	Return 2

EndFunc   ;==>MoveTSfilesFromStick

func MoveMultipleFilesOrDirs ($Path, $SearchString, $TargetDir)
	; Assign a Local variable the search handle of all files in the current directory.
	Local $fullpath=$Path & $SearchString
    Local $hSearch = FileFindFirstFile($fullpath)
	;ConsoleWrite("fullpath="& $fullpath & @CRLF)
    ; Check if the search was successful, if not display a message and return False.
    If $hSearch = -1 Then
        return True
    EndIf

    ; Assign a Local variable the empty string which will contain the files names found.
    Local $sFileName = "", $iResult = 0

    While 1
        $sFileName = FileFindNextFile($hSearch)
        ; If there is no more file matching the search.
        If @error Then ExitLoop

		;consolewrite("$sFileName="&$sFileName&@CRLF)
        ; Display the file name.
		;consolewrite("fileattrib=" & FileGetAttrib($Path & $sFileName) & @CRLF)
		$dirtest=StringInStr(FileGetAttrib($Path & $sFileName),"D")

		;ConsoleWrite("$dirtest=" & $dirtest & @crlf		)

		if $dirtest<>0 Then
			$fullpath=$Path & $sFileName
			;consolewrite ("$fullpath="&$fullpath&"  target=" & $TargetDir)
			$iResult = DirMove ($Path & $sFileName,$TargetDir & "\" & $sFileName)
			consolewrite("$iResult Dirmove=" & $iResult & @CRLF)
		Else
			$iResult = FileMove ($Path & $sFileName,$TargetDir, $FC_Overwrite)
			ConsoleWrite("$iresult filemove=" & $iresult & @CRLF)
		EndIf

        ;If $iResult <> $IDOK Then ExitLoop
    WEnd

    ; Close the search handle.
    FileClose($hSearch)
	return $iResult

EndFunc



; This function checks whether one of the Shift keys is pressed and returns TRUE if so. False otherwise
Func IsShiftPressed()
	Local $hDLL = DllOpen("user32.dll")
	If _IsPressed("10", $hDLL) Then
		; ConsoleWrite("_IsPressed - Shift Key was pressed. @extended = " & @extended & @CRLF)
		Return True
	Else
		Return False
	EndIf
	DllClose($hDLL)
EndFunc   ;==>IsShiftPressed


Func StripComment($Text)
	Return StringStripWS(StringRegExpReplace($Text, ";.*", ""), $STR_STRIPALL)
EndFunc   ;==>StripComment

Func DisplayPanel($Type, $Window2Disable, ByRef $HeaderText, ByRef $Message, ByRef $Button1, ByRef $Button2, ByRef $Button3, $ExitButtonNr = 0, $TimeOut = 0)
	; The intent of this function is to display a message for the user and also to allow select another language for the interface.
	; It can be called with an optional message text to be displayed and up to 3 buttons. One of the buttons can be defined as an exit
	; button. When that one is pressed, the whole script will exit.
	; $Type					= 1: display the $Message in a simple window
	;						= 2: Display the details panel
	; $Window2Disable 		= when called from another GUI, that GUI must be disabled while this new GUI is displayed
	;						  Fill in the handle of the other GUI. Or an empty string if no window is to be disabled
	; $HeaderText			= Text to display at the top of the Window
	; $MessageOrFlags		= Type=1 : Message that will be displayed. Or empty string if nothing is to be displayed
	;						= Type=2 : Combined message flags so that multiple messages can be displayed. This is done this way
	;							rather than concatenating the messages in the calling function because this allows for translations to be done when the panel is displayed
	; $Button1				= Text on the leftmost button. Or empty string if the button must not be displayed.
	; $Button2				= Text on the middle button. Or empty string if the button must not be displayed.
	; $Button3				= Text on the rightmost button. Or empty string if the button must not be displayed.
	; $ExitButtonNr			= Optional. Which of the buttons (1, 2 or 3) will trigger the script to terminate (after a confirmation)
	;						  Or 0 if none of them will have that behaviour.
	;
	; Return values
	; 						1, 2 or 3 when button1, button2 or button 3 are pressed respectively
	; 						When the button is pressed specified by $ExitButton then nothing is returned: the script is just terminated
	;
	; Side effects: the user can choose another language and that new value will be set in the $Language variable
	;
	; Note that when the language changes, the scripts sets the new language strings and loops to display the panel in the newly selected language.
	; Note that it is essential for most of the parameters to be ByRef, beacuse when the language changes, reference must be made to those updated values.

	If $Window2Disable <> "" Then GUISetState(@SW_DISABLE, $Window2Disable)

	Local $vchkIgnoreErrors, $txtPassword

	; make sure that at the while loop is executed at least once
	Local $LanguageChanged = True

	$WhichButtonPressed = 0
	Local $BoxHeight = 22
	Local $LabelYOffset = 4

	While $LanguageChanged = True

		; Set the value to False, since that is the outcome in most cases. It will be set to True when a language has indeed been changed.
		$LanguageChanged = False

		if $Type=1 then








		EndIf


		; sleep(500)
		; Make the window visible
		;GUISetState(@SW_SHOWNORMAL, $h_MessageGUI)
		ConsoleWrite("na GUISetState" & @CRLF)
		ConsoleWrite("Timeout=" & $TimeOut)
		If $Timeout<> 0 then AdlibRegister("CloseGUI") ;, $TimeOut)

		;sleep(500)


		GUIDelete($hGUI_TSUSBClear)


	WEnd

	consolewrite ("before reenabling the disabled window" & @CRLF)
	If $Window2Disable <> "" Then GUISetState(@SW_ENABLE, $Window2Disable)

	#EndRegion GUI MESSAGE LOOP

	ConsoleWrite("hier" & @CRLF)
	Return $WhichButtonPressed

EndFunc   ;==>DisplayPanel

Func CloseGUI()
	ConsoleWrite("CloseGui is called " & @crlf)
	;WinClose($GUIhandle2Close)
	AdlibUnRegister("CloseGUI")
endFunc


Func SplitTimeDateString($TimeDateString)
	; split YYYMMDDHHMMSS string into YYYY-MM-DD HH:MM:SS
	Local $SplittedString = StringLeft($TimeDateString, 4) & "-" & StringMid($TimeDateString, 5, 2) & "-" & StringMid($TimeDateString, 7, 2)
	$SplittedString = $SplittedString & " " & StringMid($TimeDateString, 9, 2) & ":" & StringMid($TimeDateString, 11, 2) & ":" & StringRight($TimeDateString, 2)
	ConsoleWrite($SplittedString & @CRLF)
	Return $SplittedString
EndFunc   ;==>SplitTimeDateString
