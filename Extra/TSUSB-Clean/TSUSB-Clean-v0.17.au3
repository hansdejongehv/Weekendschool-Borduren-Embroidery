Func _guiCreate()

	$mlblExplanation="This is to move all turtlestitch (.DST, .XML and ExtraData.txt) files from the USB stick to the computer. Also all the TurtleStitch backup folders will be moved. If you want to make notes to later process the material, then "
	$mlblExplanation=$mlblExplanation & "fill in the Name field and optionally a more elaborate text in the Description box. But do this before inserting the USB stick that it concerns. "
	$mlblExplanation=$mlblExplanation & "Generally the USB stick will automatically be ejected. If it is, then it is indicated."

	$hGUI_TSUSBClear = GUICreate("TSUSB-Clear", 832, 600, 210, 30, BitOR($WS_SIZEBOX, $WS_MINIMIZEBOX))

	$txtName = GUICtrlCreateInput("", 160, 100, 206, 21)
