			EndIf

		Case $btnOpenExplorer

			ShellExecute($DriveForShellExecute & "\")
			;GUICtrlSetState($btnNext,$gui_disable)
			;UICtrlSetState($btnOpenExplorer,$gui_disable)

			;_WinAPI_EjectMedia($DriveForShellExecute)

			ContinueLoop



	EndSwitch

WEnd



