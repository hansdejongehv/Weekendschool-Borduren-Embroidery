	$mlblName = GUICtrlCreateLabel("Name", 20, 100, 116, 21)
	$cmbLanguage = GUICtrlCreateCombo("Combo 1", 675, 100, 141, 20)
	$mlblVersion = GUICtrlCreateLabel("Version", 680, 540, 106, 21)
	$btnNext = GUICtrlCreateButton("Next (eject)", 20, 525, 176, 36, $GUI_DISABLE)
	$mlblLanguage = GUICtrlCreateLabel("Language", 565, 100, 91, 21)
	$mlblDescription = GUICtrlCreateLabel("Description", 20, 140, 111, 21)
	$mtxtDescription = GUICtrlCreateEdit("", 20, 170, 811, 276, BitOR($ES_AUTOVSCROLL, $ES_MULTILINE, $ES_WANTRETURN))
	$mlblResult = GUICtrlCreateLabel("Result", 20, 455, 131, 26)
	$txtResult = GUICtrlCreateEdit("", 160, 450, 661, 50, BitOR($ES_MULTILINE, $ES_AUTOVSCROLL, $ES_READONLY) )
	$btnAbort = GUICtrlCreateButton("Abort", 390, 525, 176, 36)
	$btnOpenExplorer = GUICtrlCreateButton("Open USB Stick", 205, 525, 176, 36, $GUI_DISABLE)


EndFunc   ;==>_guiCreate
